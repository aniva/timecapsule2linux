#!/bin/bash
# ==============================================================================
# mount-timecapsule.sh
# ==============================================================================
# Helper script to mount/unmount Apple Time Capsule AFP volumes using FUSE.
# Configure your settings below.
# ==============================================================================

# --- CONFIGURATION ---
TC_IP="192.168.1.6"          # IP address of your Apple Time Capsule
TC_SHARE="Data"              # Volume/Share name (default is usually 'Data')
TC_USER="admin"              # Username (default is usually 'admin')
TC_PASS="muikku"             # Disk / Device password for your Time Capsule
MOUNT_POINT="$HOME/timecapsule" # Local mount point directory
# ---------------------

# Ensure mount point directory exists
mkdir -p "$MOUNT_POINT"

case "$1" in
    mount)
        if mountpoint -q "$MOUNT_POINT"; then
            echo "Time Capsule is already mounted at $MOUNT_POINT."
        else
            echo "Mounting Time Capsule (afp://$TC_USER@$TC_IP/$TC_SHARE)..."
            mount_afpfs "afp://$TC_USER:$TC_PASS@$TC_IP/$TC_SHARE" "$MOUNT_POINT"
            # Wait up to 25 seconds for mount to register
            MOUNTED=false
            for i in {1..25}; do
                if mountpoint -q "$MOUNT_POINT"; then
                    MOUNTED=true
                    break
                fi
                sleep 1
            done
            if [ "$MOUNTED" = false ]; then
                echo "Failed to mount Time Capsule. Check logs with 'journalctl --user -n 50'."
                exit 1
            fi
            echo "Successfully mounted to $MOUNT_POINT."
        fi
        ;;
    unmount|umount)
        if mountpoint -q "$MOUNT_POINT"; then
            echo "Unmounting Time Capsule..."
            fusermount3 -u "$MOUNT_POINT"
            echo "Successfully unmounted."
        else
            echo "Time Capsule is not mounted."
        fi
        ;;
    monitor)
        # Ensure clean mount point first
        echo "Cleaning up any stale mount at $MOUNT_POINT..."
        fusermount3 -u "$MOUNT_POINT" 2>/dev/null || true

        echo "Mounting Time Capsule (afp://$TC_USER@$TC_IP/$TC_SHARE)..."
        mount_afpfs "afp://$TC_USER:$TC_PASS@$TC_IP/$TC_SHARE" "$MOUNT_POINT"

        # Wait up to 25 seconds for mount to register
        MOUNTED=false
        for i in {1..25}; do
            if mountpoint -q "$MOUNT_POINT"; then
                MOUNTED=true
                break
            fi
            sleep 1
        done

        if [ "$MOUNTED" = false ]; then
            echo "Failed to mount Time Capsule."
            exit 1
        fi
        echo "Successfully mounted to $MOUNT_POINT. Monitoring..."

        while true; do
            if ! mountpoint -q "$MOUNT_POINT"; then
                echo "Mount point dropped!"
                exit 1
            fi
            sleep 5
        done
        ;;
    status)
        if mountpoint -q "$MOUNT_POINT"; then
            echo "Status: Mounted at $MOUNT_POINT"
            echo "--- Share Contents ---"
            ls -la "$MOUNT_POINT"
        else
            echo "Status: Not mounted"
        fi
        ;;
    *)
        echo "Usage: $0 {mount|unmount|monitor|status}"
        exit 1
        ;;
esac
