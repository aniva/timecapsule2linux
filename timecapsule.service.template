[Unit]
Description=Auto-mount Apple Time Capsule via AFP FUSE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace with the absolute path to your configured mount script
ExecStart=%h/scripts/mount-timecapsule.sh monitor
ExecStop=%h/scripts/mount-timecapsule.sh unmount
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
